{
  "name": "@random-lunacy/rezrov-zmachine",
  "version": "1.0.0-rc.0",
  "description": "A modular Z-machine interpreter in TypeScript for running Infocom-style interactive fiction (Zork, Planetfall, Beyond Zork and more)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    }
  },
  "typesVersions": {
    "*": {
      "node": [
        "dist/node.d.ts"
      ]
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "tsc && tsc-esm-fix --ext .js",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"package.json\" \"README.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"package.json\" \"README.md\"",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit/",
    "test:unit-coverage": "vitest run tests/unit/ --coverage",
    "test:integration": "vitest run tests/integration/",
    "test:compliance": "vitest run tests/compliance/",
    "test:examples": "vitest run tests/examples/",
    "tools:objects": "tsx tools/GameObjectExample.ts",
    "tools:strings": "tsx tools/StringDumpExample.ts",
    "prepublishOnly": "npm run lint && npm run build && npm test"
  },
  "keywords": [
    "z-machine",
    "zmachine",
    "interactive-fiction",
    "infocom",
    "zork",
    "text-adventure",
    "interpreter",
    "quetzal",
    "blorb",
    "typescript"
  ],
  "author": "Random Lunacy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Random-Lunacy/rezrov-zmachine.git"
  },
  "bugs": {
    "url": "https://github.com/Random-Lunacy/rezrov-zmachine/issues"
  },
  "homepage": "https://github.com/Random-Lunacy/rezrov-zmachine#readme",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/glob": "^9.0.0",
    "@types/node": "^26.6.3",
    "@types/seedrandom": "^3.0.8",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-sort-class-members": "^1.22.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "ts-node": "^10.9.2",
    "tsc-esm-fix": "^3.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "seedrandom": "^3.0.5"
  },
  "peerDependencies": {
    "@types/node": ">=22"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  }
}
