{
  "name": "rezrov-zmachine",
  "version": "1.0.0",
  "description": "Z-machine interpreter in TypeScript",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "lib/",
    "dist/",
    "src/",
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "build": "tsc && tsc-esm-fix --ext .js",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\" \"package.json\" \"README.md\"",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit/",
    "test:unit-coverage": "vitest run tests/unit/ --coverage",
    "test:integration": "vitest run tests/integration/",
    "test:compliance": "vitest run tests/compliance/",
    "test:examples": "vitest run tests/examples/",
    "tools:objects": "tsx tools/GameObjectExample.ts",
    "tools:strings": "tsx tools/StringDumpExample.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/glob": "^9.0.0",
    "@types/node": "^26.6.2",
    "@types/seedrandom": "^3.0.8",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-sort-class-members": "^1.22.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "ts-node": "^10.9.2",
    "tsc-esm-fix": "^3.1.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "seedrandom": "^3.0.5"
  }
}
